{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flashforce",
  "compatibility_date": "2026-05-09",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
